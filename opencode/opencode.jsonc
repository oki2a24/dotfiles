{
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "general": {
      "model": "ollama/gemma4:26b-a4b-it-qat",
      "steps": 20
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.8:27b-mlx": {
          "name": "qwen3.8:27b-mlx (local)"
        },
        "muse-glimmer:30b-mlx": {
          "name": "muse-glimmer:30b-mlx (local)"
        },
        "gemma4:26b-a4b-it-qat": {
          "name": "gemma4:26b-a4b-it-qat (local)"
        },
        "hf.co/google/gemma-4-26B-A4B-it-qat-q4_0-gguf-local:latest": {
          "name": "hf.co/google/gemma-4-26B-A4B-it-qat-q4_0-gguf-local:latest (local)"
        },
        "gpt-oss:20b": {
          "name": "gpt-oss:20b (local)"
        }
      }
    }
  }
}
